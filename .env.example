# Copy to .env.local and fill in. Vite loads .env.local for all modes and it's
# already in .gitignore. Restart `npm run dev` after editing — env is baked at
# build time, not hot-reloaded.

# ===== LLM color commentary (Phase 4, optional) =====
# Used by src/caster/Color.ts. If unset, Tier 1 barks still fire; only the LLM
# color lane goes silent. Game keeps playing.
#
# Get key: https://console.anthropic.com → Settings → API Keys
# Note: key is exposed to the browser (hackathon scope only — rotate after).
VITE_ANTHROPIC_KEY=

# ===== SpacetimeDB connection (Phase 1, optional) =====
# Used by src/net/Connection.ts. Defaults below are correct for local dev.
# Override when pointing the client at a non-local STDB instance.
VITE_STDB_URI=ws://127.0.0.1:3000
VITE_STDB_DB=valor
